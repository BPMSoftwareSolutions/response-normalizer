{
  "semanticExecutionJournalVersion": "1.0",
  "capabilityId": "normalize-provider-response",
  "capabilityName": "Response Normalizer",
  "version": "0.1.0",
  "canonicalIntent": "Accept raw provider testimony and project it into one canonical response without inventing, repairing, or discarding material facts.",
  "canonicalOperation": "normalizesProviderResponse(context, dependencies)",

  "owns": [
    "provider-response shape recognition",
    "canonical content projection",
    "finish-disposition mapping",
    "tool-call projection",
    "structured-output extraction",
    "usage projection",
    "refusal and safety-signal preservation",
    "provider metadata preservation",
    "normalization diagnostics",
    "unsupported-shape rejection"
  ],

  "doesNotOwn": [
    "calling the provider",
    "selecting a provider or model",
    "parsing arbitrary malformed JSON into valid business output",
    "validating output against a JSON Schema",
    "deciding whether to retry",
    "calculating cost",
    "generating the final execution receipt",
    "hiding provider errors",
    "guessing missing usage values"
  ],

  "codeCategories": {
    "description": "Three code categories, none of which may carry domain decisionality. The semantic layer holds the meaning; these execute it.",
    "conformance": "./code-body.conformance.v1.json",
    "kernel": {
      "directory": "src/kernel/",
      "responsibility": "generic decision resolution, projection, iteration, predicate dispatch, and schema evaluation",
      "domainDecisionality": "none"
    },
    "adapters": {
      "directory": "src/adapters/",
      "responsibility": "file system, JSON parsing, hashing, clock, and identity mechanics",
      "domainDecisionality": "none"
    },
    "capabilityBodies": {
      "directories": [
        "src/normalize-provider-response/",
        "src/project-provider-response/"
      ],
      "responsibility": "ordered invocation of resolved authority",
      "domainDecisionality": "none"
    }
  },

  "components": [
    {
      "componentId": "normalizes-provider-response",
      "responsibility": "the collapsed execution witness: validate, resolve, verify, project, seal",
      "implementation": "src/normalize-provider-response/normalizes-provider-response.ts",
      "executionPlan": "./execution-model/normalize-provider-response.plan.v1.json"
    },
    {
      "componentId": "validates-normalization-request",
      "responsibility": "evaluates the declared request requirements and the policy contract",
      "implementation": "src/normalize-provider-response/validates-normalization-request.ts"
    },
    {
      "componentId": "resolves-provider-response-adapter",
      "responsibility": "observes adapter facts and reports the declared resolution",
      "implementation": "src/normalize-provider-response/resolves-provider-response-adapter.ts",
      "decisionId": "resolve-adapter-resolution"
    },
    {
      "componentId": "projects-declared-dialect",
      "responsibility": "executes a declared provider dialect against provider testimony",
      "implementation": "src/project-provider-response/projects-declared-dialect.ts"
    },
    {
      "componentId": "validates-canonical-response-projection",
      "responsibility": "enforces the canonical contract on adapter output",
      "implementation": "src/normalize-provider-response/validates-canonical-response-projection.ts"
    }
  ],

  "kernelEngines": [
    {
      "engineId": "resolves-declared-decision",
      "responsibility": "evaluates any declared decision table",
      "implementation": "src/kernel/resolves-declared-decision.ts"
    },
    {
      "engineId": "executes-declared-projection",
      "responsibility": "builds a target shape from a declared field map",
      "implementation": "src/kernel/executes-declared-projection.ts"
    },
    {
      "engineId": "executes-declared-iteration",
      "responsibility": "classifies a declared collection in declared order",
      "implementation": "src/kernel/executes-declared-iteration.ts"
    },
    {
      "engineId": "selects-matching-rule",
      "responsibility": "selects the first rule whose declared predicates hold",
      "implementation": "src/kernel/selects-matching-rule.ts"
    },
    {
      "engineId": "validates-against-schema",
      "responsibility": "evaluates a value against a declared JSON Schema",
      "implementation": "src/kernel/validates-against-schema.ts"
    },
    {
      "engineId": "reads-declared-path",
      "responsibility": "resolves a declared path and evaluates a declared predicate",
      "implementation": "src/kernel/reads-declared-path.ts"
    }
  ],

  "contracts": {
    "canonicalResponse": "./canonical-model-response.schema.json",
    "normalizationPolicy": "./normalization-policy.schema.json",
    "providerDialect": "./provider-dialect.schema.v1.json",
    "decision": "./decision.schema.v1.json",
    "codeBodyConformance": "./code-body.conformance.v1.json"
  },

  "decisions": [
    {
      "decisionId": "resolve-finish-disposition",
      "responsibility": "maps provider finish testimony to the canonical disposition",
      "declaration": "./decisions/resolve-finish-disposition.decision.v1.json"
    },
    {
      "decisionId": "resolve-usage-disposition",
      "responsibility": "classifies how completely usage was testified to",
      "declaration": "./decisions/resolve-usage-disposition.decision.v1.json"
    },
    {
      "decisionId": "resolve-arguments-disposition",
      "responsibility": "classifies tool-call argument testimony",
      "declaration": "./decisions/resolve-arguments-disposition.decision.v1.json"
    },
    {
      "decisionId": "resolve-structured-output-disposition",
      "responsibility": "classifies structured-output testimony",
      "declaration": "./decisions/resolve-structured-output-disposition.decision.v1.json"
    },
    {
      "decisionId": "resolve-adapter-resolution",
      "responsibility": "decides whether exactly one adapter is authorized",
      "declaration": "./decisions/resolve-adapter-resolution.decision.v1.json"
    },
    {
      "decisionId": "resolve-normalization-failure",
      "responsibility": "classifies an observed failure into the stable vocabulary",
      "declaration": "./decisions/resolve-normalization-failure.decision.v1.json"
    },
    {
      "decisionId": "classify-content-segment",
      "responsibility": "classifies one provider content part into a segment kind",
      "declaration": "./decisions/classify-content-segment.decision.v1.json"
    }
  ],

  "iterations": [
    {
      "iterationId": "project-content-segments",
      "responsibility": "declares collection, order, classifier, and aggregation for content parts",
      "declaration": "./iterations/project-content-segments.iteration.v1.json"
    }
  ],

  "executionModel": "./execution-model/normalize-provider-response.plan.v1.json",

  "projections": [
    {
      "projectionId": "project-openai-chat-completions",
      "declaration": "./dialects/openai.dialect.v1.json"
    },
    {
      "projectionId": "project-gemini-generate-content",
      "declaration": "./dialects/gemini.dialect.v1.json"
    },
    {
      "projectionId": "project-anthropic-messages",
      "declaration": "./dialects/anthropic.dialect.v1.json"
    }
  ],

  "ports": [
    {
      "portId": "reads-clock",
      "responsibility": "supplies the normalization instant",
      "effect": "read-clock"
    },
    {
      "portId": "hashes-value",
      "responsibility": "produces the deterministic raw-response hash",
      "effect": "compute"
    },
    {
      "portId": "issues-response-identity",
      "responsibility": "supplies the canonical response identifier",
      "effect": "generate-identity"
    }
  ],

  "acceptanceAuthority": "../acceptance/normalizes-provider-response.feature",

  "dispositions": [
    { "code": "NORMALIZED", "exitCode": 0 },
    { "code": "NORMALIZATION_REQUEST_INVALID", "exitCode": 10 },
    { "code": "PROVIDER_ADAPTER_NOT_FOUND", "exitCode": 11 },
    { "code": "PROVIDER_ADAPTER_AMBIGUOUS", "exitCode": 12 },
    { "code": "PROVIDER_RESPONSE_NOT_RECOGNIZED", "exitCode": 13 },
    { "code": "PROVIDER_RESPONSE_MALFORMED", "exitCode": 20 },
    { "code": "CANONICAL_PROJECTION_INVALID", "exitCode": 21 },
    { "code": "RAW_RESPONSE_HASH_MISMATCH", "exitCode": 22 },
    { "code": "NORMALIZATION_POLICY_UNSUPPORTED", "exitCode": 30 },
    { "code": "NORMALIZATION_FAILED", "exitCode": 50 }
  ],

  "providerDialects": [
    {
      "dialectId": "openai-chat-completions",
      "providerId": "openai",
      "status": "declared",
      "declaration": "./dialects/openai.dialect.v1.json"
    },
    {
      "dialectId": "gemini-generate-content",
      "providerId": "gemini",
      "status": "declared",
      "declaration": "./dialects/gemini.dialect.v1.json"
    },
    {
      "dialectId": "anthropic-messages",
      "providerId": "anthropic",
      "status": "declared",
      "declaration": "./dialects/anthropic.dialect.v1.json"
    },
    { "dialectId": "litellm", "providerId": "litellm", "status": "deferred" },
    { "dialectId": "llamacpp", "providerId": "llamacpp", "status": "deferred" }
  ],

  "proof": {
    "proofContractId": "response-normalization-proof.v1",
    "requiredAssertions": [
      "raw-response-hash-recorded",
      "raw-response-hash-verified-against-supplied-testimony",
      "provider-finish-reason-preserved",
      "canonical-response-validated-against-declared-schema",
      "usage-projected-only-from-observed-testimony",
      "diagnostics-recorded-for-preserved-anomalies",
      "deterministic-output-byte-stable-under-fixed-clock-and-identity"
    ]
  }
}
