{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capability.local/response-normalizer/finish-disposition.decision.schema.v1.json",
  "title": "Finish Disposition Decision Table",
  "description": "The canonical mapping from provider finish testimony to the controlled disposition vocabulary. Authored in the semantic layer so the decision is inspectable rather than hidden in a code body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "inputs", "matching", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "decisionId": { "const": "resolve-finish-disposition" },
    "description": { "type": "string" },

    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "providerId",
          "providerFinishReason",
          "refusalPresent",
          "safetyBlocked",
          "toolCallsPresent"
        ]
      }
    },

    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerFinishReason", "order"],
      "properties": {
        "providerFinishReason": {
          "enum": ["case-sensitive", "case-insensitive"]
        },
        "order": { "const": "first-matching-rule-wins" }
      }
    },

    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "when", "then"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "providerId": { "type": ["string", "null"] },
              "providerFinishReason": {
                "description": "A list of accepted provider values, null to match absent testimony, or \"*\" as the terminal catch-all.",
                "oneOf": [
                  { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                  { "type": "null" },
                  { "const": "*" }
                ]
              },
              "refusalPresent": { "type": "boolean" },
              "safetyBlocked": { "type": "boolean" },
              "toolCallsPresent": { "type": "boolean" }
            }
          },
          "then": {
            "enum": [
              "completed",
              "length-limited",
              "tool-calls-requested",
              "refused",
              "safety-blocked",
              "content-filtered",
              "cancelled",
              "provider-failed",
              "malformed-provider-response",
              "unsupported-provider-response",
              "unknown"
            ]
          },
          "diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "path", "message"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "severity": { "enum": ["info", "warning", "error"] },
              "path": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
